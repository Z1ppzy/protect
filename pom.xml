<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.haven</groupId>
    <artifactId>Haven</artifactId>
    <!-- Схема версии: 26.n.n (26 = 2026 год), n растёт без предела. -->
    <version>26.12.1</version>
    <packaging>jar</packaging>
    <name>Haven</name>
    <description>Anti-grief via container locking, personal trust and reputation.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API. Если сервер новее/старее — поменяй версию и api-version в plugin.yml. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- PlaceholderAPI: для %haven_tag% в TAB. На сервере ставится отдельно (softdepend). -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- SQLite: шейдится внутрь jar (default backend). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
        </dependency>
        <!-- HikariCP: пул соединений для MySQL/MariaDB. Shaded + relocated → не ссорится с другими плагинами. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <!-- SLF4J nop: HikariCP пишет в SLF4J; чтобы не тянуть logback и не упасть с "no provider" — заглушка. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!-- MariaDB JDBC: test-only. На сервере драйвер грузится через plugin.yml libraries: блок.
             В main-code обращений по типу нет — только Class.forName("org.mariadb.jdbc.Driver") и
             setDriverClassName(...) строкой, поэтому compile classpath не нужен. -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.6</version>
            <scope>test</scope>
        </dependency>

        <!-- Тесты -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Моковый Bukkit-сервер для интеграционных тестов листенеров. -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>4.108.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: поднимает MariaDB в Docker для тестов MysqlStorage. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mariadb</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Default: Haven-${version}.jar — версия в имени файла, чтобы не путать сборки. -->
        <resources>
            <!-- Подставляем ${project.version} в plugin.yml — версия из одного места (pom). -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Не создавать промежуточный Haven-<v>-shaded.jar — заменяем оригинал
                                 in-place, на выходе ровно один артефакт Haven-<v>.jar. -->
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <!-- Relocations: чтобы наш HikariCP/SQLite не конфликтовали с теми же
                                 классами в других плагинах (LuckPerms / CoreProtect / ...). -->
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>ru.haven.libs.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.sqlite</pattern>
                                    <shadedPattern>ru.haven.libs.sqlite</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>ru.haven.libs.slf4j</shadedPattern>
                                </relocation>
                            </relocations>
                            <!-- Не тащим лишнее. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Чистим original-*.jar (pre-shade backup), который оставляет shade-плагин.
                 Объявлен ПОСЛЕ shade — Maven гарантирует порядок внутри фазы package.
                 Результат target/: ровно один Haven-${version}.jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>cleanup-shade-backup</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.directory}/original-${project.artifactId}-${project.version}.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
